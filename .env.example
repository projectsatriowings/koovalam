# ==============================================================================
# KOOVALAM RETREAT — EMAIL CONFIGURATION
# ==============================================================================
# Copy this file to `.env` in your project root:
#   copy .env.example .env
#
# DO NOT commit `.env` with your real password to Git (it is already in .gitignore).
# When deploying to hosting platforms (Vercel, Netlify, Render, etc.), enter
# these same variables into the hosting platform's Environment Variables dashboard.
# ==============================================================================

# 1. GMAIL SMTP CONFIGURATION (info.koovalam@gmail.com)
# The official Gmail address where enquiries are delivered:
CLIENT_ENQUIRY_EMAIL=info.koovalam@gmail.com

# The Gmail username used to send the notification email:
GMAIL_USER=info.koovalam@gmail.com

# Your 16-character Google App Password (spaces will be automatically stripped):
# e.g., abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=your_16_digit_app_password_here

# 2. OPTIONAL TRANSACTIONAL PROVIDER (Alternative to Gmail SMTP)
# EMAIL_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM="Koovalam Retreats <onboarding@resend.dev>"
